status_label_proxy = None


def _on_window_close():
    """X button — hide to tray; the app keeps running."""
    try:
        root.withdraw()
        log_line("[APP] Window hidden to tray (X pressed)")
        if TRAY_ICON is None and (BACKGROUND_MODE or START_MINIMIZED_TO_TRAY):
            start_tray_icon()
    except Exception:
        try:
            root.destroy()
        except Exception:
            pass


