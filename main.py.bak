    ping_count_lbl.pack(side=tk.RIGHT)

    ping_widget = scrolledtext.ScrolledText(pc, wrap=tk.WORD,
                                            font=("Consolas", 9),
                                            bg="#0b1220", fg="#a7f3d0",
                                            relief=tk.FLAT,
                                            insertbackground="#93c5fd",
